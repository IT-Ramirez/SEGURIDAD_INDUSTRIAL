.env
.env.local
config.local.php
config.php

# === Dependencias de Composer / Node ===
# Si llegas a usar librerías de terceros, no deben subirse a GitHub
/vendor/
/node_modules/

# === Archivos del Sistema Operativo ===
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# === IDEs y Editores de Código ===
